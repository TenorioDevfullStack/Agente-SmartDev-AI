# Copie para .env e preencha. O .env é ignorado pelo git.

# Chave de autenticação da Evolution API (header "apikey").
AUTH_KEY=

# Numero que recebe /leads e alertas de atendimento humano. Deve ser diferente dos prospectos.
# Formato: DDI + DDD + numero, so digitos. Ex.: 5511999998888
ADMIN_NUMBER=

# Contato pessoal do Leandro, repassado so a quem procura assunto particular.
# Mesmo formato: DDI + DDD + numero, so digitos.
CONTATO_PESSOAL=

# ===== LLM =====
# "groq" (nuvem) ou "ollama" (local, fallback). Trocar aqui nao exige rebuild.
LLM_PROVIDER=groq
GROQ_API_KEY=
PROSPECCAO_PERMITIR_BAILEYS=false
# Usado somente quando a instância Evolution estiver em WHATSAPP-BAILEYS.
# Inclua {{1}} para substituir o nome da empresa.
PROSPECCAO_MODELO_TEXTO=
GROQ_MODEL=openai/gpt-oss-120b

# ===== PAINEL =====
# Senha inicial do login admin, criado uma única vez no MongoDB.
# O primeiro acesso exige uma senha pessoal. Alterar esta variável não
# redefine usuários existentes. Veja README.md para recuperação local.
PAINEL_SENHA=

# ===== TÚNEL (painel na internet) =====
# Token do Cloudflare Tunnel, criado em Zero Trust > Networks > Tunnels.
# É ele que publica o painel no seu domínio. Vazio, o container cloudflared
# sobe e morre em laço — o resto do stack continua funcionando local.
TUNNEL_TOKEN=
